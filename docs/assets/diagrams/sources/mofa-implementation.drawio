" height="15" as="geometry"/></mxCell><mxCell id="mofacfg" value="&lt;b&gt;MOFAConfig&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:10px&#x27;&gt;«extends ModelConfig»&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:10px&#x27;&gt;mosa.models.mofa.config&lt;/font&gt;" style="fontFamily=Helvetica;fontColor=#222222;swimlane;html=1;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=43.5;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;fillColor=#E0E0E0;strokeColor=#616161;swimlaneFillColor=#FFFFFF;fontSize=11;spacing=1;" vertex="1" parent="1"><mxGeometry x="245" y="337" width="158" height="88.5" as="geometry"/></mxCell><mxCell id="mofacfg_00" value="n_factors · convergence_mode" style="fontFamily=Helvetica;fontColor=#222222;text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="mofacfg"><mxGeometry x="0" y="43.5" width="158" height="15" as="geometry"/></mxCell><mxCell id="mofacfg_01" value="ard_factors · drop_r2 · iterations" style="fontFamily=Helvetica;fontColor=#222222;text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="mofacfg"><mxGeometry x="0" y="58.5" width="158" height="15" as="geometry"/></mxCell><mxCell id="mofacfg_02" value="scale_views · scale_groups" style="fontFamily=Helvetica;fontColor=#222222;text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="mofacfg"><mxGeometry x="0" y="73.5" width="158" height="15" as="geometry"/></mxCell><mxCell id="n_mofa" value="&lt;b&gt;External-model adaptation&lt;/b&gt;&lt;br&gt;Input matrices are organized by view and model_type. Masked values become NaN.&lt;br&gt;&lt;br&gt;fit() delegates to mofapy2; validation data are unused. save_outputs() writes model HDF5 and shared Parquet outputs.&lt;br&gt;&lt;br&gt;transform() retrieves factors for unchanged training samples and projects unseen samples by least squares, subject to input compatibility requirements. Gaussian reconstructions reverse scaling and restore group means. File identification belongs to the model package." style="fontFamily=Helvetica;fontColor=#222222;shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=5;spacingRight=3;spacingTop=2;fontSize=10;size=10;" vertex="1" parent="1"><mxGeometry x="0" y="214.5" width="202" height="189" as="geometry"/></mxCell><mxCell id="e_api_ds" value="consumes" style="fontFamily=Helvetica;fontColor=#222222;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=open;endSize=7;dashed=1;strokeColor=#1976D2;exitX=1;exitY=0.2317;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="api" target="ds"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_mofa_ds" value="consumes" style="fontFamily=Helvetica;fontColor=#222222;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=open;endSize=7;dashed=1;strokeColor=#1976D2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="mofa" target="ds"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n_mofa_l" value="" style="fontFamily=Helvetica;fontColor=#222222;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=none;dashed=1;strokeColor=#B8A246;exitX=1;exitY=0.244709;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.7533;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n_mofa" target="mofa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_cfg_mofa" value="configures" style="fontFamily=Helvetica;fontColor=#222222;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=open;endSize=7;dashed=1;strokeColor=#555555;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="mofacfg" target="mofa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>